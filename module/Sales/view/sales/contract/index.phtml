<?php $this->headTitle('Hợp đồng'); $filters = $searchForm->getSubmittedData(); ?>
<h1>Hợp đồng</h1>
<?php foreach ($this->flashMessenger()->getSuccessMessages() as $message): ?><p role="status"><?= $this->escapeHtml($message) ?></p><?php endforeach; ?>
<?php foreach ($this->flashMessenger()->getErrorMessages() as $message): ?><p role="alert"><?= $this->escapeHtml($message) ?></p><?php endforeach; ?>
<?php if ($canEdit): ?><p><a href="<?= $this->url('contracts', ['action' => 'create']) ?>">Thêm hợp đồng</a></p><?php endif; ?>
<?= $this->partial('partial/contract/search-form', ['form' => $searchForm, 'errors' => $errors]) ?>
<?php if ($paginator === null || count($paginator) === 0): ?>
    <p>Chưa có hợp đồng nào khớp điều kiện lọc.</p>
<?php else: ?>
    <table>
        <caption>Tổng cộng <?= (int)$paginator->getTotalItemCount() ?> hợp đồng</caption>
        <thead><tr><th>Số</th><th>Khách hàng</th><th>Hiệu lực</th><th>Trạng thái</th><th>Tổng tiền</th><th>Thao tác</th></tr></thead>
        <tbody><?php foreach ($paginator as $item): ?><tr>
            <td><?= $this->escapeHtml((string)$item->getContractNo()) ?></td>
            <td>#<?= (int)$item->getCustomerId() ?></td>
            <td><?= $this->escapeHtml(\Application\Model\DateModel::displayDate($item->getEffectiveFrom())) ?> → <?= $this->escapeHtml(\Application\Model\DateModel::displayDate($item->getEffectiveTo())) ?></td>
            <td><?= $this->escapeHtml($item->getStatusLabel()) ?></td>
            <td><?= number_format((int)$item->getTotalAmount(), 0, ',', '.') ?></td>
            <td><a href="<?= $this->url('contracts', ['action' => 'detail', 'id' => (int)$item->getId()]) ?>">Chi tiết</a><?php if ($canEdit): ?> <a href="<?= $this->url('contracts', ['action' => 'edit', 'id' => (int)$item->getId()]) ?>">Sửa</a><?php endif; ?></td>
        </tr><?php endforeach; ?></tbody>
    </table>
    <?php $currentPage = (int)$paginator->getCurrentPageNumber(); $totalPages = (int)count($paginator); ?>
    <nav aria-label="Phân trang"><p>Trang <?= $currentPage ?> / <?= $totalPages ?></p>
        <?php if ($currentPage > 1): ?><a href="<?= $this->url('contracts') ?>?<?= $this->escapeHtmlAttr(http_build_query(array_merge($filters, ['page' => $currentPage - 1]))) ?>">Trang trước</a><?php endif; ?>
        <?php if ($currentPage < $totalPages): ?><a href="<?= $this->url('contracts') ?>?<?= $this->escapeHtmlAttr(http_build_query(array_merge($filters, ['page' => $currentPage + 1]))) ?>">Trang sau</a><?php endif; ?>
    </nav>
<?php endif; ?>
