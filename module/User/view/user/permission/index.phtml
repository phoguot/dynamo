<?php
/**
 * Ma trận phân quyền của MỘT người dùng — module × thao tác.
 *
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var User\Model\User\UserModel $user
 * @var User\Form\User\UserPermissionForm $permissionForm
 * @var User\Form\User\UserPermissionResetForm $resetForm
 * @var array<string, string[]> $roleDefaults
 * @var array<string, string>   $overrides
 * @var array<string, array<string, bool>> $effective
 * @var bool $isAdminAccount
 * @var array<string, string> $errors
 */

$this->headTitle('Phân quyền — ' . (string)$user->getFullName());
$detailUrl = $this->url('users', ['action' => 'detail', 'id' => (int)$user->getId()]);
?>
<div class="pageHead permHead">
    <div>
        <h1>Phân quyền</h1>
        <p>
            <?= $this->escapeHtml((string)$user->getFullName()) ?>
            (<?= $this->escapeHtml((string)$user->getUsername()) ?>) ·
            vai trò <span class="badge"><?= $this->escapeHtml($user->getRoleLabel()) ?></span>
        </p>
    </div>
    <nav class="actions">
        <a href="<?= $this->escapeHtmlAttr($detailUrl) ?>">Về chi tiết tài khoản</a>
    </nav>
</div>

<?php foreach ($this->flashMessenger()->getSuccessMessages() as $message): ?>
    <p role="status"><?= $this->escapeHtml($message) ?></p>
<?php endforeach; ?>
<?php foreach ($this->flashMessenger()->getErrorMessages() as $message): ?>
    <p role="alert"><?= $this->escapeHtml($message) ?></p>
<?php endforeach; ?>

<?php if ($isAdminAccount): ?>
    <p role="alert">
        Tài khoản Quản trị hệ thống luôn có toàn quyền và không phân quyền riêng được.
        Muốn giới hạn thì đổi vai trò của tài khoản này trước.
    </p>
    <?php return; ?>
<?php endif; ?>

<section class="panel permLegend" aria-label="Cách đọc bảng phân quyền">
    <div class="permLegend__item">
        <span class="permLegend__key">Mặc định vai trò</span>
        <span>Quyền vai trò “<?= $this->escapeHtml($user->getRoleLabel()) ?>” đã có sẵn.</span>
    </div>
    <div class="permLegend__item">
        <span class="permLegend__key">Ngoại lệ</span>
        <span>Điều chỉnh riêng cho người này. Để trống = theo vai trò.</span>
    </div>
    <div class="permLegend__item">
        <span class="permLegend__key">Kết quả</span>
        <span>Quyền thực tế sau khi cộng ngoại lệ vào mặc định.</span>
    </div>
    <p class="permLegend__note">
        Cấp thêm quyền cho màn hình mà vai trò này không được vào sẽ không có tác dụng: mỗi
        action phải được khai trong ACL, action chưa khai luôn bị từ chối.
    </p>
</section>

<?= $this->partial('partial/permission/matrix-form', [
    'form'         => $permissionForm,
    'user'         => $user,
    'roleDefaults' => $roleDefaults,
    'overrides'    => $overrides,
    'effective'    => $effective,
    'errors'       => $errors,
]) ?>

<section class="panel permReset">
    <div class="panelHead">
        <strong>Gỡ toàn bộ ngoại lệ</strong>
    </div>
    <p class="permReset__hint">Đưa tài khoản về đúng quyền mặc định của vai trò.</p>
    <?= $this->partial('partial/permission/reset-form', [
        'form' => $resetForm,
        'user' => $user,
    ]) ?>
</section>
