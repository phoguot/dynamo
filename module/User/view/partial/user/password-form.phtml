<?php
/**
 * MARKUP form quản trị đặt lại mật khẩu cho một tài khoản.
 *
 * Form này có CSRF token RIÊNG (`user.user.password`), khác token của form đổi trạng thái —
 * token của form kia không dùng để đặt mật khẩu được.
 *
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var User\Form\User\UserPasswordForm $form
 * @var User\Model\User\UserModel $user
 * @var array<string, string> $errors
 */

$row = fn (array $config): string => $this->partial(
    'partial/form/row',
    // Cố ý truyền `values` rỗng: không bao giờ đổ mật khẩu ngược lại vào HTML.
    $config + ['values' => [], 'errors' => $errors]
);
?>
<?= $this->partial('partial/form/open', [
    'form'   => $form,
    'action' => $this->url('users', ['action' => 'resetpassword', 'id' => $user->getId()]),
    'class'  => 'form-reset-password',
]) ?>

    <?= $row([
        'name'     => 'password',
        'label'    => 'Mật khẩu mới',
        'type'     => 'password',
        'required' => true,
        'hint'     => 'Tối thiểu 10 ký tự. Gửi cho người dùng qua kênh an toàn.',
        'attrs'    => ['autocomplete' => 'new-password'],
    ]) ?>

    <?= $row([
        'name'     => 'passwordConfirm',
        'label'    => 'Nhập lại mật khẩu mới',
        'type'     => 'password',
        'required' => true,
        'attrs'    => ['autocomplete' => 'new-password'],
    ]) ?>

    <?= $this->partial('partial/form/actions', [
        'submitLabel' => 'Đặt lại mật khẩu',
        'confirm'     => 'Mật khẩu cũ sẽ mất hiệu lực ngay. Tiếp tục?',
    ]) ?>

<?= $this->partial('partial/form/close') ?>
