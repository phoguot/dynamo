<?php
/**
 * MARKUP form thêm mới / sửa máy phát điện.
 *
 * Đây là nơi DUY NHẤT chứa markup của form này — trang chỉ gọi partial, controller không
 * biết gì về HTML. Field khai ở Fleet\Form\Generator\GeneratorSaveForm; tên field ở đây
 * phải khớp tên khai trong form đó.
 *
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var Fleet\Form\Generator\GeneratorSaveForm $form
 * @var Fleet\Model\Generator\GeneratorModel|null $generator
 * @var array<string, string> $errors
 */

$isEdit = $generator !== null;
$values = $form->getSubmittedData();

/** Gọn call site: mỗi field chỉ khai phần khác nhau, values/errors gắn tự động. */
$row = fn (array $config): string => $this->partial(
    'partial/form/row',
    $config + ['values' => $values, 'errors' => $errors]
);

/** Field đã hiện lỗi ngay dưới ô nhập — không nhắc lại ở khối lỗi đầu form. */
$fieldsWithOwnError = [
    'code', 'name', 'capacityKva', 'fuelType', 'serialNumber',
    'manufacturer', 'model', 'hourMeter', 'currentLocation', 'note',
];
?>
<?= $this->partial('partial/form/errors', ['errors' => $errors, 'fields' => $fieldsWithOwnError]) ?>

<?= $this->partial('partial/form/open', ['form' => $form, 'class' => 'form-generator']) ?>

    <?= $row([
        'name'     => 'code',
        'label'    => 'Mã máy',
        'required' => true,
        'hint'     => 'Chữ in hoa, số và dấu gạch ngang. Ví dụ: MP-001.',
        'attrs'    => ['maxlength' => 30, 'autocomplete' => 'off'],
    ]) ?>

    <?= $row([
        'name'     => 'name',
        'label'    => 'Tên máy',
        'required' => true,
        'attrs'    => ['maxlength' => 120],
    ]) ?>

    <?= $row([
        'name'     => 'capacityKva',
        'label'    => 'Công suất (kVA)',
        'type'     => 'number',
        'required' => true,
        'attrs'    => ['min' => 1, 'step' => 1],
    ]) ?>

    <?= $row([
        'name'     => 'fuelType',
        'label'    => 'Nhiên liệu',
        'control'  => 'select',
        'required' => true,
        'choices'  => $form->fuelChoices(),
    ]) ?>

    <?= $row([
        'name'  => 'serialNumber',
        'label' => 'Số serial',
        'attrs' => ['maxlength' => 120],
    ]) ?>

    <?= $row([
        'name'  => 'manufacturer',
        'label' => 'Hãng sản xuất',
        'attrs' => ['maxlength' => 120],
    ]) ?>

    <?= $row([
        'name'  => 'model',
        'label' => 'Model',
        'attrs' => ['maxlength' => 120],
    ]) ?>

    <?php if (!$isEdit): ?>
        <?= $row([
            'name'  => 'hourMeter',
            'label' => 'Giờ máy hiện tại',
            'type'  => 'number',
            'hint'  => 'Máy mua mới để 0. Sau khi tạo, giờ máy chỉ cập nhật qua nghiệp vụ giao/thu hồi.',
            'attrs' => ['min' => 0, 'step' => '0.1'],
        ]) ?>
    <?php endif; ?>

    <?= $row([
        'name'  => 'currentLocation',
        'label' => 'Vị trí hiện tại',
        'attrs' => ['maxlength' => 120],
    ]) ?>

    <?= $row([
        'name'    => 'note',
        'label'   => 'Ghi chú',
        'control' => 'textarea',
        'attrs'   => ['maxlength' => 255, 'rows' => 3],
    ]) ?>

    <?= $this->partial('partial/form/actions', [
        'submitLabel' => $isEdit ? 'Lưu thay đổi' : 'Thêm máy',
        'cancelUrl'   => $this->url('generators'),
    ]) ?>

<?= $this->partial('partial/form/close') ?>
