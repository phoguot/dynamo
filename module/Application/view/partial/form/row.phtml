<?php
/**
 * Một dòng form: nhãn → ô nhập → gợi ý → thông báo lỗi.
 *
 * Đây là partial DUY NHẤT các module gọi để dựng field. Không tự viết <label>/<input>
 * trong view của module — sửa một chỗ ở đây là mọi form đổi theo.
 *
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var string $name     tên field, khớp tên khai trong AppForm
 * @var string $label    nhãn tiếng Việt có dấu
 * @var array<string, mixed>  $values dữ liệu đang có (bản ghi cũ hoặc thứ người dùng vừa gõ)
 * @var array<string, string> $errors lỗi theo field, lấy từ $form->getMessagesArr()
 * @var string|null $control  input | select | textarea. Mặc định input
 * @var string|null $type     loại input HTML (text, number, date, email…)
 * @var bool|null   $required
 * @var string|null $hint     câu gợi ý dưới ô nhập
 * @var array<string, string>|null $attrs   thuộc tính HTML thêm (maxlength, min, step…)
 * @var array<string|int, string>|null $choices  danh sách chọn cho control=select
 * @var string|null $emptyChoice nhãn dòng trống đầu select
 */

$control  = $control ?? 'input';
$required = !empty($required);
$error    = $errors[$name] ?? null;
$errorId  = 'err-' . $name;
$value    = $values[$name] ?? '';

$controlVars = [
    'name'        => $name,
    'value'       => $value,
    'type'        => $type ?? 'text',
    'required'    => $required,
    'hasError'    => $error !== null,
    'errorId'     => $errorId,
    'attrs'       => $attrs ?? [],
    'choices'     => $choices ?? [],
    'emptyChoice' => $emptyChoice ?? '— Chọn —',
];
?>
<div class="form-row<?= $error !== null ? ' form-row--error' : '' ?>">
    <label for="<?= $this->escapeHtmlAttr($name) ?>">
        <?= $this->escapeHtml($label) ?><?php if ($required): ?><span aria-hidden="true">&nbsp;*</span><?php endif; ?>
    </label>

    <?= $this->partial('partial/form/control/' . $control, $controlVars) ?>

    <?php if (!empty($hint)): ?>
        <small class="form-hint"><?= $this->escapeHtml($hint) ?></small>
    <?php endif; ?>

    <?php if ($error !== null): ?>
        <p class="form-error" id="<?= $this->escapeHtmlAttr($errorId) ?>" role="alert">
            <?= $this->escapeHtml($error) ?>
        </p>
    <?php endif; ?>
</div>
