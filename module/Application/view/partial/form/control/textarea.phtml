<?php
/**
 * Ô nhập nhiều dòng. Gọi qua partial/form/row.
 *
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var string $name
 * @var mixed  $value
 * @var bool   $required
 * @var bool   $hasError
 * @var string $errorId
 * @var array<string, string> $attrs
 */

$attrs = ($attrs ?? []) + ['rows' => 3];
?>
<textarea id="<?= $this->escapeHtmlAttr($name) ?>"
          name="<?= $this->escapeHtmlAttr($name) ?>"
          <?= $required ? 'required' : '' ?>
          <?= $hasError ? 'aria-invalid="true" aria-describedby="' . $this->escapeHtmlAttr($errorId) . '"' : '' ?>
          <?= $this->partial('partial/form/control/attrs', ['attrs' => $attrs]) ?>><?= $this->escapeHtml((string)$value) ?></textarea>
