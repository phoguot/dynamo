            <span aria-hidden="true">DG</span>
            <div>
                <strong>Dynamo Rental</strong>
                <small><?= $this->escapeHtml($today->format(\Application\Model\DateModel::DISPLAY_DATE_FORMAT)) ?> · ca vận hành</small>
            </div>
        </a>

        <nav class="navStack">
            <div class="railLabel">Màn hình</div>
            <?php foreach ($navItems as $item): ?>
                <?php $active = $isActive($item['prefixes']); ?>
                <a class="navButton<?= $active ? ' active' : '' ?>"
                   href="<?= $this->url($item['route']) ?>"
                   <?= $active ? 'aria-current="page"' : '' ?>>
                    <span><?= $this->escapeHtml($item['label']) ?></span>
                    <span class="navCode"><?= $this->escapeHtml($item['code']) ?></span>
                </a>
            <?php endforeach; ?>
        </nav>
    </aside>

    <main class="main" id="main-content">
        <div class="command">
            <button class="navMenu" type="button" data-nav-toggle aria-controls="app-yard" aria-expanded="false">
