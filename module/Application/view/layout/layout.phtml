        </div>

        <?php if ($currentModuleTab !== null): ?>
            <nav class="moduleTabs" aria-label="<?= $this->escapeHtmlAttr((string)$currentModuleTab['label']) ?>">
                <a class="moduleTab<?= !$isFormTab ? ' active' : '' ?>"
                   href="<?= $this->url($currentModuleTab['route']) ?>"
                   <?= !$isFormTab ? 'aria-current="page"' : '' ?>>
                    Danh sách
                </a>
                <?php if ($currentModuleTab['createLabel'] !== null): ?>
                    <a class="moduleTab<?= $isFormTab ? ' active' : '' ?>"
                       href="<?= $this->url($currentModuleTab['route'], ['action' => 'create']) ?>"
                       <?= $isFormTab ? 'aria-current="page"' : '' ?>>
                        <?= $this->escapeHtml((string)$currentModuleTab['createLabel']) ?>
                    </a>
                <?php endif; ?>
            </nav>
        <?php endif; ?>

        <div class="screen active<?= $isModuleListPage ? ' screen--moduleList' : '' ?>">
            <?= $this->content ?>
        </div>
    </main>
</div>
<?= $this->inlineScript()->prependFile($this->basePath() . '/js/app.js') ?>
