<?php
$this->headTitle('Phiếu cọc');
$filters = $searchForm->getSubmittedData();
?>
<h1>Phiếu cọc</h1>
<?php foreach ($this->flashMessenger()->getSuccessMessages() as $message): ?><p role="status"><?= $this->escapeHtml($message) ?></p><?php endforeach; ?>
<?php foreach ($this->flashMessenger()->getErrorMessages() as $message): ?><p role="alert"><?= $this->escapeHtml($message) ?></p><?php endforeach; ?>
<?php if ($canCreate): ?><p><a href="<?= $this->url('deposits', ['action' => 'create']) ?>">Thêm phiếu cọc</a></p><?php endif; ?>
<?= $this->partial('partial/deposit/search-form', ['form' => $searchForm, 'errors' => $errors]) ?>
<?php if ($paginator === null || count($paginator) === 0): ?>
    <p>Chưa có phiếu cọc nào khớp điều kiện lọc.</p>
<?php else: ?>
    <table>
        <caption>Tổng cộng <?= (int)$paginator->getTotalItemCount() ?> phiếu cọc</caption>
        <thead><tr><th>Số</th><th>Khách hàng</th><th>Hợp đồng</th><th>Đơn thuê</th><th>Ngày nhận</th><th>Số tiền</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
        <tbody><?php foreach ($paginator as $item): ?><tr>
            <td><?= $this->escapeHtml((string)$item->getDepositNo()) ?></td>
            <td>#<?= (int)$item->getCustomerId() ?></td>
            <td><?= $item->getContractId() ? '#' . (int)$item->getContractId() : '-' ?></td>
            <td><?= $item->getRentalOrderId() ? '#' . (int)$item->getRentalOrderId() : '-' ?></td>
            <td><?= $this->escapeHtml(\Application\Model\DateModel::displayDate($item->getReceivedDate())) ?></td>
            <td><?= number_format($item->getAmount(), 0, ',', '.') ?> đ</td>
            <td><?= $this->escapeHtml($item->getStatusLabel()) ?></td>
            <td><a href="<?= $this->url('deposits', ['action' => 'detail', 'id' => (int)$item->getId()]) ?>">Chi tiết</a><?php if ($canEdit): ?> <a href="<?= $this->url('deposits', ['action' => 'edit', 'id' => (int)$item->getId()]) ?>">Sửa</a><?php endif; ?></td>
        </tr><?php endforeach; ?></tbody>
    </table>
    <?php $currentPage = (int)$paginator->getCurrentPageNumber(); $totalPages = (int)count($paginator); ?>
    <nav aria-label="Phân trang"><p>Trang <?= $currentPage ?> / <?= $totalPages ?></p>
        <?php if ($currentPage > 1): ?><a href="<?= $this->url('deposits') ?>?<?= $this->escapeHtmlAttr(http_build_query(array_merge($filters, ['page' => $currentPage - 1]))) ?>">Trang trước</a><?php endif; ?>
        <?php if ($currentPage < $totalPages): ?><a href="<?= $this->url('deposits') ?>?<?= $this->escapeHtmlAttr(http_build_query(array_merge($filters, ['page' => $currentPage + 1]))) ?>">Trang sau</a><?php endif; ?>
    </nav>
<?php endif; ?>
