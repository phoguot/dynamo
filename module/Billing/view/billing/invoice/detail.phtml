<?php
$this->headTitle('Hóa đơn ' . (string)$invoice->getInvoiceNo());
?>
<h1>Hóa đơn <?= $this->escapeHtml((string)$invoice->getInvoiceNo()) ?></h1>
<?php foreach ($this->flashMessenger()->getSuccessMessages() as $message): ?><p role="status"><?= $this->escapeHtml($message) ?></p><?php endforeach; ?>
<?php foreach ($this->flashMessenger()->getErrorMessages() as $message): ?><p role="alert"><?= $this->escapeHtml($message) ?></p><?php endforeach; ?>
<p><a href="<?= $this->url('invoices') ?>">Quay lại danh sách</a><?php if ($canEdit): ?> · <a href="<?= $this->url('invoices', ['action' => 'edit', 'id' => (int)$invoice->getId()]) ?>">Sửa</a><?php endif; ?></p>
<dl>
    <dt>Khách hàng</dt><dd>#<?= (int)$invoice->getCustomerId() ?></dd>
